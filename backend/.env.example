# ─────────────────────────────────────────────────────────────
# LLM Provider Configuration
# ─────────────────────────────────────────────────────────────
#
# Choose ONE provider. Copy this file to .env and fill in keys.
#
# Option 1: Groq — FREE tier, fastest, recommended for getting started
#   Sign up: https://console.groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama3-70b-8192
# Other free Groq models: llama3-8b-8192, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it

# Option 2: Google Gemini — FREE tier
#   Sign up: https://aistudio.google.com
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-1.5-flash
# Other models: gemini-1.5-pro, gemini-2.0-flash

# Option 3: OpenAI — Paid
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini
# Frontier model: gpt-4o

# Option 4: Anthropic — Paid
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-haiku-4-5-20251001
# Frontier model: claude-sonnet-4-6

# Option 5: Ollama — Local, no API key required
#   Install: https://ollama.com  then run: ollama pull llama3
# LLM_PROVIDER=ollama
# OLLAMA_ENDPOINT=http://localhost:11434
# LLM_MODEL=llama3

# ─────────────────────────────────────────────────────────────
# Storage Paths
# ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
CHROMA_DIR=./chroma_db
DB_PATH=./resume_database.json
