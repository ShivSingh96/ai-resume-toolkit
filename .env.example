# ─── LLM Provider ────────────────────────────────────────────────────────────
# Which provider to use: groq | gemini | openai | anthropic | ollama
LLM_PROVIDER=groq

# Model to use (must be available on your account for the chosen provider).
# Groq free models: qwen/qwen3.8-27b, qwen/qwen3.6-27b, groq/compound, openai/gpt-oss-20b
# Gemini free: gemini-1.5-flash, gemini-2.0-flash
# OpenAI paid: gpt-4o-mini, gpt-4o
# Anthropic paid: claude-haiku-4-5-20251001, claude-sonnet-4-6
LLM_MODEL=qwen/qwen3.8-27b
# ─── API Keys (only the key for your chosen provider is required) ─────────────
GROQ_API_KEY=your_groq_api_key_here # https://console.groq.com
GEMINI_API_KEY=your_gemini_api_key_here # https://aistudio.google.com/apikey
OPENAI_API_KEY=your_openai_api_key_here # https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=your_anthropic_key_here # https://console.anthropic.com/settings/keys
# Ollama (local — no key needed, just run `ollama serve`)
OLLAMA_ENDPOINT=http://localhost:11434
# ─── Job Discovery (Adzuna) ───────────────────────────────────────────────────
# Free tier: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
# ─── Supabase (optional — for persistent resume storage) ─────────────────────
# Leave blank to use local JSON storage instead.
# Use the service_role secret key (NOT the anon public key) — found under:
# Supabase dashboard → Project Settings → API → service_role secret
# Then enable RLS on the resumes table to block public anon access.
SUPABASE_URL=
SUPABASE_KEY=